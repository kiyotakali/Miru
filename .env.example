# ============================================================
# Miru Server Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# === LLM Provider (required) ===
# Current runtime uses 3 OpenAI-compatible tiers configured in Admin UI
# or via these env vars. OpenRouter host can be written as openrouter.ai;
# ai_config.py normalizes it to openrouter.ai/api before appending /v1.
#
# Recommended OpenRouter cost/performance baseline (2026-05):
#   vision: Gemini 2.5 Flash Lite — cheap multimodal screenshot analysis
#   chat:   GPT-4.1 Mini          — reliable multimodal/tool-use conversation
#   memory: Qwen3 235B A22B       — cheap strong text JSON/slot routing
AI_VISION_HOST=openrouter.ai
AI_VISION_KEY=sk-or-your-openrouter-key
AI_VISION_MODEL=google/gemini-2.5-flash-lite

AI_CHAT_HOST=openrouter.ai
AI_CHAT_KEY=sk-or-your-openrouter-key
AI_CHAT_MODEL=openai/gpt-4.1-mini

AI_MEMORY_HOST=openrouter.ai
AI_MEMORY_KEY=sk-or-your-openrouter-key
AI_MEMORY_MODEL=qwen/qwen3-235b-a22b-2507

# === Public server address (required for invitation codes) ===
# Invitation v1 encodes public IPv4 + public port into MIRU-XXXXXXXXXX-YYYYYY.
# Use a real public IPv4 here. Do not put a domain name in SERVER_IP.
SERVER_IP=
SERVER_PORT=5001

# === Domain (optional for legacy HTTPS/web deployments) ===
# Your server's public domain. Used for CORS/HTTPS in legacy domain setups.
# Private-server v1 invitation login does not depend on DOMAIN.
# Example: miru.example.com
DOMAIN=

# === Optional ===
# Flask port (default: 5001)
# PORT=5001
# Flask debug mode (default: false in Docker)
# FLASK_DEBUG=false
# Timezone (default: server local time)
# Example: Asia/Shanghai, America/New_York
# TIMEZONE=Asia/Shanghai
# Data directory (default: /app/data in Docker, ./data locally)
# DATA_DIR=/app/data
