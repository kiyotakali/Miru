# Miru private server runtime config.
# This file is written to /opt/miru/.env by install.sh.

MIRU_IMAGE=miru/server:0.2.0
MIRU_CONTAINER_NAME=miru-server

SERVER_IP=
SERVER_PORT=5001

TZ=Asia/Shanghai
TIMEZONE=Asia/Shanghai

AI_VISION_HOST=openrouter.ai/api
AI_VISION_KEY=
AI_VISION_MODEL=qwen/qwen3.5-9b

AI_CHAT_HOST=api.deepseek.com
AI_CHAT_KEY=
AI_CHAT_MODEL=deepseek-v4-pro

AI_MEMORY_HOST=api.deepseek.com
AI_MEMORY_KEY=
AI_MEMORY_MODEL=deepseek-v4-flash
